int limit_page_cache_ratio(int ratio)
{
 int min = 5;
 char p[] = "100XXX";

 if (ratio > 100 || ratio < min)
  return -1;

 if (ratio < 90) {




  if (get_meminfo_item("MemTotal") <= 64)
   min = 90;
 }

 if (ratio < min)
  ratio = min;

 sprintf(p, "%d", ratio);
 return f_write_string("/proc/sys/vm/pagecache_ratio", p, 0, 0);
}
