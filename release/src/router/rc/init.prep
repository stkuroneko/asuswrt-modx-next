extern unsigned int get_root_type(void);

void package_defaults(int restore_defaults)
{

 unsigned int root_type = get_root_type();




 if (restore_defaults) {
  struct statfs sf;
  int is_jffs2_mounted = 0;
  if ((statfs("/jffs", &sf) == 0) && (sf.f_type != root_type)) {
   is_jffs2_mounted = 1;
