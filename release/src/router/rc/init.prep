{
 int stb_x;


 if ((strlen((nvram_get("switch_wantag") ? : "")) > 0 && !nvram_match("switch_wantag", "none")) ||
     (nvram_match("switch_wantag", "none") && ((stb_x = nvram_get_int("switch_stb_x")) > 0 && stb_x <= 6)))
  return 1;

 return 0;
}
