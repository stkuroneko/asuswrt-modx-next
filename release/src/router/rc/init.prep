enum {
 UI_SW_MODE_NONE=0,
 UI_SW_MODE_ROUTER,
 UI_SW_MODE_REPEATER,
 UI_SW_MODE_AP,
 UI_SW_MODE_MB,
 UI_SW_MODE_HOTSPOT,
 UI_SW_MODE_EXPRESS_2G,
 UI_SW_MODE_EXPRESS_5G
};

static inline int get_sw_mode(void)
{
 int wlc_psta = nvram_get_int("wlc_psta");
 int wlc_express = nvram_get_int("wlc_express");

 switch((nvram_get("sw_mode") ? nvram_get_int("sw_mode") : atoi(nvram_default_get("sw_mode")))){
  case 1:
   return UI_SW_MODE_ROUTER;
  case 2:
   if(wlc_psta==0){
    if(wlc_express==0)
     return UI_SW_MODE_REPEATER;
    else if(wlc_express==1)
     return UI_SW_MODE_EXPRESS_2G;
    else if(wlc_express==2)
     return UI_SW_MODE_EXPRESS_5G;
   }else if(wlc_psta==1)
    return UI_SW_MODE_MB;
   break;
  case 3:
   if(wlc_psta==0)
    return UI_SW_MODE_AP;
   else if(wlc_psta==1)
    return UI_SW_MODE_MB;
   else if(wlc_psta==2 || wlc_psta==3)
    return UI_SW_MODE_REPEATER;
   break;
  case 4:
   return UI_SW_MODE_HOTSPOT;
 }

 return UI_SW_MODE_NONE;
}







