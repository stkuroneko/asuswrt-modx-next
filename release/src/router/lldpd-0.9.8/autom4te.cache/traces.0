m4trace:configure.ac:171: -1- PKG_CHECK_MODULES([libbsd], [libbsd-overlay], [
  _save_CFLAGS="$CFLAGS"
  _save_LIBS="$LIBS"
  CFLAGS="$CFLAGS $libbsd_CFLAGS"
  LIBS="$LIBS $libbsd_LIBS"
  AC_MSG_CHECKING([if libbsd can be linked correctly])
  AC_TRY_LINK([
@%:@include <sys/time.h>
@%:@include <sys/types.h>
],[],
    [
      AC_MSG_RESULT(yes)
      LLDP_CFLAGS="$LLDP_CFLAGS $libbsd_CFLAGS"
      LLDP_LDFLAGS="$LLDP_LDFLAGS $libbsd_LIBS"
    ],[
      AC_MSG_RESULT(no)
      CFLAGS="$_save_CFLAGS"
      LIBS="$_save_LIBS"
    ])
], [:])
