static inline int __absent_band(enum wl_band_id band)
{
 if (band < 0 || band >= WL_NR_BANDS)
  return 1;

 if (band >= 2)
  return 1;
# 1607 "./shared.h"
 if (band == WL_60G_BAND)
  return 1;


 return 0;
}


static inline int absent_band(enum wl_band_id band)
{
 if (__absent_band(band) == 1)
  return 1;

 if (!nvram_get(wl_nvname("nband", band, 0)))
  return 1;

 return 0;
}






