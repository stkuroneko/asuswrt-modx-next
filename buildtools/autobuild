my $month = (localtime)[4] + 1;
my $day = (localtime)[3];
my $hour = (localtime)[2];
my $min = (localtime)[1];
my $kernel_ver;
my $fs_ver;
my $serialno;
my $extendno;
my $releasedir = $ENV{'ASUSWRTRELEASEDIR'};
my $backupdir = $ENV{'ASUSWRTBACKUPDIR'};
my $localreleasedir = $ENV{LOCALRELEASEDIR};
my $localbackupdir = $ENV{LOCALBACKUPDIR};
