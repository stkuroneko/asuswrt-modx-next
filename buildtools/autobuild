sub chrealdir
{
	my $fhandle;
	my $fexclude;
	my $mdir = "";
	my $model_gpl = "";
	my $uc_model;

	chdir "$builddir";

	$uc_model=uc($_[0]);
	$model_gpl = $_[0];
	# found model and included src-xx

	$fwsizelimit = "0";
	if(open($fhandle, "./${asuswrtdir}/release/models")) {
		while (<$fhandle>) {
			chomp;
			if(/^\[/) {
				s/\[//g;
				s/\]//g;
				$mdir = $_;
			}
			else {
				$line=$_;
				s/\ *;.*//;
				chomp;
				if($model_gpl eq $_) {
					$modeldir = $mdir;
					if ( $line =~ /\"fwsize\"/ ) { 
						$line=~ s/.*{//;
						$line=~ s/}.*//;
						$line=~ s/.*\"fwsize\"//;
						$line=~ s/.*?\"//;
						$line=~ s/\".*//;
						$fwsizelimit=$line;
					}
				}
			}
		}
	}
	close($fhandle);

	if( $modeldir eq "" ) {
		print "no model found\n";
		exit;
	}

	chdir "$builddir/${asuswrtdir}/release/$modeldir/";
}

sub autosync
{
	my $f,$s;

	# generate version
	open($f, "${versionconf}");

	while (<$f>) {
		chomp;
		if (/KERNEL_VER=/) {
			s/KERNEL_VER=//;
			$kernel_ver = $_;
		}
		if (/FS_VER/) {
			s/FS_VER=//;
			$fs_ver = $_;
		}
		if (/SERIALNO/) {
			s/SERIALNO=//;
			$serialno = $_;
		}
		if (/RCNO/) {
			s/RCNO=//;
			$rcno = $_;
		}
	}
	close ($f);

	if ( $ARGV[0] =~ /tag/ ) {
		$oldversioninfo = "${kernel_ver}.${fs_ver}.${serialno}";
		$versioninfo = "${kernel_ver}.${fs_ver}.${serialno}";

		# add tag
		chdir "$builddir/${asuswrtdir}";

		# if in a swpj branch, add sw branch tag
		system("swpj=`git branch | grep \"*\" | grep \"swpj-\" | sed 's/.*swpj-//g'`; swpjver=`cat ./release/src/router/APP-IPK/\$swpj/CONTROL/control | grep \"Version:\" | sed 's/Version: //g'`; echo \"SWPJ=\$swpj\" > swpj.conf; echo \"SWPJVER=\$swpjver\" >> swpj.conf");
		if(open($s, "swpj.conf")) {
			while (<$s>) {
				chomp;
				if (/SWPJ=/) {
					s/SWPJ=//;
					$swpj = $_;
				}
				if (/SWPJVER=/) {
					s/SWPJVER=//;
					$swpj_ver = $_;
				}
			}
			close($s);
		}
		else {
			$swpj = "";
			$swpj_ver = "";
		}
		system("rm -f swpj.conf");

		if (length($swpj)!=0 && length($swpj_ver)!=0) {
			system("git tag -fa swpj_${swpj}_${swpj_ver} -m \"swpj ${swpj} release ${swpj_ver}\"");
			system("git tag -fa swpj_${swpj}_${swpj_ver}_latest -m \"the latest swpj ${swpj} release ${swpj_ver}\"");
		}
		else {
			system("git tag -fa asuswrt_${versioninfo} -m \"release ${versioninfo}\"");
			system("git tag -fa asuswrt_${versioninfo}_latest -m \"the latest release ${versioninfo}\"");
		}
	}
	else {
		$oldversioninfo = "${kernel_ver}.${fs_ver}.${serialno}";
		$versioninfo = "${kernel_ver}.${fs_ver}.${serialno}";
	}

	system("[ ! -f ${builddir}/${asuswrtdir}/release/src/router/extendno.conf ] && cd ${builddir}/${asuswrtdir}/release/src/router && echo EXTENDNO=`git log --pretty=oneline asuswrt_${kernel_ver}.${fs_ver}.${serialno}..HEAD | wc -l`-g`git log --pretty=format:'%h' -n 1` > extendno.conf");
	my @cmd = ('perl', '-pi', '-e', 's,([0-9a-f]{7})[0-9a-f]*,\1,', "${builddir}/${asuswrtdir}/release/src/router/extendno.conf");
	system(@cmd);

	$extendno="0";
	open($f, "$builddir/${asuswrtdir}/release/src/router/extendno.conf");
	while (<$f>) {
		chomp;
		if (/EXTENDNO/) {
			s/EXTENDNO=//;
			$extendno = $_;
		}
	}
	close($f);
}

sub creategpl
{
	my $fhandle;
	my $dhandle;
	my $fexclude;
	my $mdir="";
	my $model_gpl="";
	my $uc_model;

	$uc_model=uc($_[0]);
	if($ARGV[0]=~/gpl/) {
		autoclean();

		# assign correct target.mak
		if( $versionconfdir ne "" ) {
			system("cp -f $versionconfdir/target.mak ./${asuswrtdir}/release/${modeldir}/target.mak");
		}

		$pbdir = "${builddir}/${pbprefix}/${uc_model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}";
		if (open($fhandle, "${pbdir}")) {
			close($fhandle);
		} else {
			printf "$pbdir not exist!!!\n";
		}

		# Copy prebuilt binary
		printf "Copy pre-built binary from ${pbdir} to ${builddir}/${asuswrtdir}\n";
		system("cd ${pbdir}; tar cf - . | tar xf - -C ${builddir}/${asuswrtdir}");

		chdir "$builddir";

		# remark because of putting utf8 header into code
		#system("sh asuswrt/buildtools/codeprep.sh $builddir");

		#Add exclusive file when building GPL
		# rules for kernel release
		# src-ra exclude linux in src/src-rt
		# src-rt/src-rt-5.70 exlude linux in src/src-ra/
		# src exclude linux in src-rt/src-rra
		unlink("./excludes");
		system("touch ./excludes");
		open($fexclude, ">./excludes");

		# model related exclude is controlled by .gpl_excludes now
		# if(open($fhandle, "./${asuswrtdir}/release/models")) {
		# 	while (<$fhandle>) {
		# 		chomp;
		# 		if(/^\[/) {
		# 			s/\[//g;
		#			s/\]//g;
		#			if ($_ ne $modeldir) {
		#				print $fexclude "./${asuswrtdir}/release/$_\n";
		#			}
		#		}
		#	}
		# }
		# close($fhandle);

		if (open($fhandle, "./${asuswrtdir}/.gpl_excludes")) {
			while (<$fhandle>) {
				if ( $_ ne "" ) {
					print $fexclude "${asuswrtdir}/$_";
				}
			}
			close($fhandle);
		}

		if ( -e "./${asuswrtdir}/release/${modeldir}/.gpl_excludes.pl" ) {
			# append model dep exlude list here
			system("cd ./${asuswrtdir}/release/${modeldir} && ./.gpl_excludes.pl $uc_model release/${modeldir}");
			if(open($fhandle, "./${asuswrtdir}/release/${modeldir}/.gpl_excludes.sysdeps")) {
				while (<$fhandle>) {
					if ( $_ ne "" ) {
						print $fexclude "${asuswrtdir}/$_";
					}
				}
				close($fhandle);
				unlink("./${asuswrtdir}/release/${modeldir}/.gpl_excludes.sysdeps");
			}

		}

		if(open($fhandle, "./${asuswrtdir}/release/${modeldir}/.gpl_excludes")) {
			while (<$fhandle>) {
				if ( $_ ne "" ) {
					print $fexclude "${asuswrtdir}/$_";
				}
			}
			close($fhandle);
		}

		if(open($fhandle, "./${asuswrtdir}/release/.gpl_excludes_router")) {
			while (<$fhandle>) {
				if ( $_ ne "" ) {
					print $fexclude "${asuswrtdir}/$_";
				}
			}
			close($fhandle);
		}

		# default include src/src-rt/${modeldir} only 
		if(opendir ($dhandle, "./${asuswrtdir}/release")) {
			while (my $dir=readdir($dhandle)) {
				if ( $dir =~ /src/ ) {
					$tmpmodeldir = $modeldir;
					$tmpmodeldir =~ s/\/.*//;
					if ( $dir ne "${tmpmodeldir}" && $dir ne "src-rt" && $dir ne "src" ) {
						print $fexclude "${asuswrtdir}/release/$dir\n";
					}
				}
			}
			closedir($dhandle);
		}

		system("find ${asuswrtdir} -maxdepth 3 -type f -name .gpl_excludes -print >> ./excludes");
		system("find ${asuswrtdir} -type f -name .gitignore -print >> ./excludes");

		open($fhandle, "${versionconf}");
		while (<$fhandle>) {
			chomp;
			if (/KERNEL_VER=/) {
				s/KERNEL_VER=//;
				$kernel_ver = $_;
			}
			if (/FS_VER/) {
				s/FS_VER=//;
				$fs_ver = $_;
			}
			if (/SERIALNO/) {
				s/SERIALNO=//;
				$serialno = $_;
			}
			if (/RCNO/) {
				s/RCNO=//;
				$rcno = $_;
			}
		}
		close($fhandle);

		system("[ ! -f ${builddir}/${asuswrtdir}/release/src/router/extendno.conf ] && cd ${builddir}/${asuswrtdir}/release/src/router && echo EXTENDNO=`git log --pretty=oneline asuswrt_${kernel_ver}.${fs_ver}.${serialno}..HEAD | wc -l`-g`git log --pretty=format:'%h' -n 1` > extendno.conf");
		my @cmd = ('perl', '-pi', '-e', 's,([0-9a-f]{7})[0-9a-f]*,\1,', "${builddir}/${asuswrtdir}/release/src/router/extendno.conf");
		system(@cmd);
		$extendno = "0";
		open($fhandle,"${builddir}/${asuswrtdir}/release/src/router/extendno.conf");
		while (<$fhandle>) {
			chomp;
			if (/EXTENDNO=/) {
				s/EXTENDNO=//;
				$extendno = $_;
			}
		}
		close($fhandle);

		close($fexclude);

		unlink("./excludefiles");
		system("touch ./excludefiles");

		if(open($fexclude, "./excludes")) {
			while (<$fexclude>) {
				chomp;
				#print "find $_";
				if($_ ne "") {
					system("find ${_} -print >> ./excludefiles");
				}
			}
		}
		close($fexclude);

		printf "Processing *.gpl\n";
		system("for f in `find ./${asuswrtdir} -type f -name \"*.gpl\"`; do g=`echo \$f|sed -e 's,\\.gpl\$,,'`; echo \"=> Replace \$g with \$f\"; mv \$f \$g ; done");

		if(open($fhandle, "./${asuswrtdir}/release/${modeldir}/update_licenses.pl")) {
			system("cd ./${asuswrtdir}/release/${modeldir} ; echo \"`pwd`\"; ./update_licenses.pl . --stage=2; cd -");
		}

		print "Generate GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.tgz\n";
		# FILES parameter of tar command MUST be last parameter.
		# If not, tar of Fedora 25 won't exclude files in ./excludes and won't transform directory path.
		system("tar cvf GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.tar -X ./excludes --transform 's,^\./${asuswrtdir}/*,asuswrt/,' --exclude-vcs ./${asuswrtdir} > GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.lst");
		
		if(open($fhandle, "./${asuswrtdir}/release/${modeldir}/.gpl_includes")) {
			while (<$fhandle>) {
				chomp;
				if ( $_ ne "" ) {
					printf "include ${_} into tarball\n";
					system("tar rvf GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.tar --transform 's,^\./${asuswrtdir}/*,asuswrt/,' ./${asuswrtdir}/${_} >> GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.lst");
				}
			}
			close($fhandle);
		}
		system("gzip -c GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.tar > GPL_${uc_model}_${kernel_ver}.${fs_ver}.${serialno}.${extendno}.tgz");

		chdir "${builddir}/${asuswrtdir}";
		system("git checkout -f");
		chdir "${builddir}";

		unlink("./excludes");
		unlink("./excludefiles");

		chrealdir();
	}
}

sub autoclean
{
	$orig_dir = `pwd`;
	chomp $orig_dir;
	chdir "../..";
	print "Clean-up git repository!!!\n";
	system("git stash");
	system("git clean -xdf 1>/dev/null");
	chdir "$orig_dir";
}

sub getlastcommit()
{
	my $f;
	my $localcommit="";

	$commit="";
	system("git show $oldversioninfo > tmp");
	open($f, "tmp");
	while (<$f>) {
		if ( /commit / ) {
			chomp;
			s/commit //;
			$localcommit = $_;
		}

	}
	close($f);
	system("rm -f tmp");

	# check if this commit is the latest one
	system("git log $localcommit.. > tmp");
	open($f, "tmp");
	while (<$f>) {
		if ( /commit / ) {
			$commit = $localcommit
		}

	}
	close($f);
	system("rm -f tmp");
}

sub generatelog
{
	my $commitlog;
	my $changelog;

	# get log from last commit
	system ("git log $commit.. --pretty=\"short\" > ./image/commit.log");

	open($commitlog, "./image/commit.log");
	open($changelog, ">> ./image/change.log");
	print $changelog sprintf("%s%02s%02s - %s.%s build %s\n", $year, $month, $day, $kernel_ver, $fs_ver, $serialno);

	while (<$commitlog>) {
		chomp;
		s/ *//;
		if ( /commit /) {
			print $changelog "\n";
		}
		elsif ( /Author: / ) {
		}
		elsif ( /Merge: / ) {
		}
		elsif ( /Merge branch/ ) {
		}
		elsif ( length($_) > 0 ) {
			s/^[0-9]. //;
			print $changelog "   ".$_."\n";
		}
	}
	print $changelog "\n";
	close($commitlog);
	close($changelog);
	system("rm ./image/commit.log -f");
}

