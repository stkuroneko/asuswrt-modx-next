sub is_prebuilt_binary_exist
{
	$uc_model=uc($_[0]);

	if ( -e "${builddir}/${pbprefix}/${uc_model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}/release" ) {
		return 1;
	}
	else {
		printf "${builddir}/${pbprefix}/${uc_model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}/release not exist\n";
		return 0;
	}	
}

sub update_prebuilt_binary
{
	my $fhandle;

	if ($_[0] eq "") {
		return -1;
	}

	$uc_model=uc($_[0]);
	$pbdir = "${builddir}/${pbprefix}/${uc_model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}";
	printf "pbdir: ${pbdir}\n";
	system("mkdir -p ${pbdir}");

	if(open($fhandle, "upb.mak")) {
		close($fhandle);
		system("make gen_prebuilt PBDIR=${pbdir}");
	}
}

sub automake
{
	my $cmd;
	my $f;
	my $log;
	my $commit;

	#tag: build firmware image file and GPL
	#gpl :only build GPL
	#only model name: build model's firmware image file
	if($ARGV[0]=~/tag/)
	{
		foreach $model(@ARGV)
		{
			if($model=~/tag/)
			{
				printf"skip tag keyword";
			}
			else
			{
				# it will also change to current model dir too
				# create tar ball only when ARGV[0]=taggpl
				chrealdir(${model});
				autoclean();

				$cmd = "mkdir ./image && make ${model} V=99 2>&1 | tee ./image/make-${model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}.log";
				system("$cmd");
				update_prebuilt_binary(${model});
				autoinstall(${model});
				creategpl(${model});
			}
		}
	}
	elsif($ARGV[0]=~/gpl/)
	{
		# running here,
		# wl binary may not belong to its models
		foreach $model(@ARGV)
		{
			if($model=~/gpl/)
			{
				printf"skip gpl keyword\n";
			}
			else
			{
				$ENV{'LIVE_UPDATE_RSA_GPL'} = '1';
				chrealdir(${model});
				if(!is_prebuilt_binary_exist(${model})) {	
					autoclean();
					$cmd = "mkdir ./image && make ${model} V=99 2>&1 | tee ./image/make-${model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}.log";
					system("$cmd");
					update_prebuilt_binary(${model});
				}
				creategpl(${model});
				delete $ENV{"LIVE_UPDATE_RSA_GPL"};
			}
		}
	}
	else
	{
		foreach $model(@ARGV)
		{
			chrealdir(${model});
			autoclean();
			$cmd = "make ${model} V=99 2>&1 | tee ./image/make-${model}.${kernel_ver}.${fs_ver}.${serialno}.${extendno}.log";
			system($cmd);
			update_prebuilt_binary(${model});
			autoinstall(${model});
		}
	}
}

if (@ARGV >= 1) {
	# usage autobulid [tag] [model] [model] ..
	$builddir = `pwd`;
	chomp $builddir;
	print "pwd= $builddir\n";

	if( $asuswrtdir eq "" ) {
		$asuswrtdir = "asuswrt";
	}

	$asuswrtdir =~ s/^\.\.*\/*//;
	$asuswrtdir =~ s/\/*$//;
	printf "asuswrtdir: ${asuswrtdir}\n";

	if( $versionconfdir eq "" ) {
		$versionconf = "./${asuswrtdir}/release/src-rt/version.conf";
	}
	else
	{
		$versionconf = "$versionconfdir/version.conf";
	}
	printf "versionconf: $versionconf\n";

	autosync();
	automake();
}

